{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local Folio shell may access document commands and receive events.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "allow-choose-files", "allow-take-pending", "allow-read-document", "allow-release-document",
    "allow-recent-files", "allow-open-recent", "allow-forget-recent",
    "allow-open-with", "allow-open-external", "allow-print-document",
    "allow-sync-menu", "allow-set-app-theme"
  ]
}
